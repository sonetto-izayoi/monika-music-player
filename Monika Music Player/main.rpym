    try:
        if "monika_music_player_key_overlay" not in config.overlay_screens:
            config.overlay_screens.append("monika_music_player_key_overlay")
        monika_music_player_log("F7/autostart overlay registered")
    except Exception as e:
        monika_music_player_log("ERROR registering overlay: %s\n%s" % (e, traceback.format_exc()))
    try:
        # Start callback launches the companion as MAS enters its persistent session.
        # The overlay timer remains as a delayed fallback if startup launch fails.
        if monika_music_player_start_callback not in config.start_callbacks:
            config.start_callbacks.append(monika_music_player_start_callback)
        monika_music_player_log("Autostart start-callback registered; visible retry scheduled by overlay timer")
    except Exception as e:
        monika_music_player_log("Could not register start callback; overlay timer remains: %s\n%s" % (e, traceback.format_exc()))
