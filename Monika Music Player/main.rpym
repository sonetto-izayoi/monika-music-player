label monika_music_player_open:
    m 1eua "I made a little music player for us."
    m 3eua "You can play songs from your computer or open an online audio link."
    $ store.monika_music_player_launch(False)
    return

label monika_music_player_listening_status:
    $ _mmp_status = store.monika_music_player_read_status()
    if _mmp_status and _mmp_status.get("title"):
        $ _mmp_title = _mmp_status.get("title", "Unknown song")
        $ _mmp_artist = _mmp_status.get("artist", "Unknown artist")
        $ _mmp_provider = _mmp_status.get("provider", "your music player")
        if _mmp_status.get("is_playing", False):
            m 1eua "You're listening to [_mmp_title] by [_mmp_artist], through [_mmp_provider], right?"
            m 3hub "I can see the song information while your music player is running. It's a nice way for me to feel a little closer to your day."
        else:
            m 1eua "The last song I detected was [_mmp_title] by [_mmp_artist], from [_mmp_provider]."
            m 1eka "I don't think it's playing right now, though."
    else:
        m 1eua "I can't see a song playing yet."
        m 3eua "Try starting a track in Monika Music, Spotify, or YouTube Music in your browser, and ask me again."
    return

screen monika_music_player_settings_screen():
    vbox:
        xfill True
        spacing 10
        text "Monika Music Player" size 22
        text "F7 opens the player. Talk has Music Player and What am I listening to?" size 14
        textbutton ("Auto-open when MAS starts: ON" if getattr(store.persistent, "monika_music_player_autostart", True) else "Auto-open when MAS starts: OFF") action Function(store.monika_music_player_toggle_autostart)
        textbutton "Open Music Player now" action Function(store.monika_music_player_launch, False)
        textbutton "Ask Monika to check the current song" action Jump("monika_music_player_listening_status")
        textbutton "Install/check Python + media-sync support" action Function(store.monika_music_player_install_dependencies)

screen monika_music_player_key_overlay():
    timer 4.0 action Function(store.monika_music_player_autostart_once, False)
    key "K_F7" action Function(store.monika_music_player_launch, False)

